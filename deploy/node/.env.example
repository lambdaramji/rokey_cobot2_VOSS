# Nodes PC 전용: ms-03 (172.24.3.240)
# 이 파일은 Git에 공유하는 템플릿이다. 실제 암호를 넣지 않는다.
# 이 파일을 deploy/node/.env로 복사한 뒤 비밀번호를 채운다.
# ROS는 .env를 자동으로 읽지 않는다. 노드 시작 전 실행 쉘에서 로드해야 한다.
# 근거: docs/interfaces/mqtt.md (#20), deployment_two_pc_trial.md.

# hmi_bridge → SSH 터널 → Web PC Mosquitto (127.0.0.1:1883)
# Web PC docker/mqtt/secrets/passwd 에 만든 bridge 계정 암호
VOSS_MQTT_BRIDGE_PASSWORD=

# sort_logger → SSH 터널 → Web PC PostgreSQL (127.0.0.1:5432)
# Web PC docker/db/.env 의 VOSS_DB_LOGGER_PASSWORD 와 동일한 값
VOSS_DB_LOGGER_PASSWORD=

# Nodes PC 연결 주소는 기존 ROS 코드 기본값으로 사용한다.
# voice_listener, intent_parser, speech_out → http://127.0.0.1:8000
# intent_parser 이력 조회 → http://127.0.0.1:8080
# hmi_bridge → 127.0.0.1:1883
# sort_logger db_host=127.0.0.1 db_port=5432
# 위 포트들은 모두 Web PC로 향하는 SSH 로컬 포워드가 먼저 필요하다.
# debug MQTT 계정은 ROS 노드가 사용하지 않으므로 여기 넣지 않는다.
