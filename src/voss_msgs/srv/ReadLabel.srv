# sort_manager → label_reader. 재확인 구역 정지 재판독 (3단계)
int32 track_id               # -1 = 시야 안 박스 아무거나 (재확인 구역에는 박스 1개뿐)
uint8 max_frames             # 다수결에 쓸 최대 프레임 수. 0 = 기본 5
float32 timeout_s            # 0 = 기본 2.0
---
bool ok
voss_msgs/LabelRead label    # stage = 3
string message               # 실패 사유: timeout / no_box / no_text
