string zone              # A | B | C | RECHECK | HOLD | OBSERVE (대문자. voss_config zones 키는 대소문자 무시, OBSERVE = observe_pose)
int32 slot               # 격자 칸 번호 (0부터 −X 끝부터, zones.<zone>.grid 순서). VIEW·OBSERVE 는 무시
string mode              # "" = PLACE (놓기 + OBSERVE 복귀) | VIEW (카메라로 구역을 보는 자세로만 이동) | PICK (slot 에서 집어 안전 높이로)
---
bool ok                  # PLACE 는 OBSERVE 복귀까지 마친 뒤 응답한다 (응답 즉시 다음 추종 시작 가능)
string message           # 실패 시 대문자 코드로 시작 (GRIP_FAIL / TIMEOUT / LIMIT / BUSY / RETURN_FAILED / STOPPED / INVALID / NOT_CONFIGURED)
builtin_interfaces/Time placed_stamp   # PLACE: RG2 개방 완료 확인 시각 (호스트 시계). 그 밖의 mode 는 0
# RETURN_FAILED = 개방 후 OBSERVE 복귀 실패: ok=false 이고 placed_stamp 는 채운다. 개방 전 실패는 placed_stamp = 0
# STOPPED = /voss/robot/stop 이 진행 중 동작을 끊음: ok=false, 이미 개방했으면 placed_stamp 를 채우고 개방 전이면 0
