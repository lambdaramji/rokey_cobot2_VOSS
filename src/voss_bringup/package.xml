<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voss_bringup</name>
  <version>0.1.0</version>
  <description>launch·설정·브링업</description>
  <maintainer email="team@example.com">김학민</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>voss_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>voss_robot</exec_depend>
  <exec_depend>voss_servo</exec_depend>
  <exec_depend>voss_manager</exec_depend>
  <exec_depend>voss_vision</exec_depend>
  <exec_depend>voss_voice</exec_depend>
  <exec_depend>voss_hmi</exec_depend>
  <!-- realsense2_camera(with_camera)는 공용 PC 에 설치된 외부 패키지 — CI rosdep 이 받지 않게 적지 않는다 -->
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
