<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voss_vision</name>
  <version>0.1.0</version>
  <description>박스 검출·추적, 송장 OCR</description>
  <maintainer email="team@example.com">남현지</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>voss_msgs</depend>
  <depend>sensor_msgs</depend>
