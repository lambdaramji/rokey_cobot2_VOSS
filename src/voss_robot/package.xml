<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voss_robot</name>
  <version>0.1.0</version>
  <description>두산 단일 호출 큐·RG2·구역 이동</description>
  <maintainer email="team@example.com">김학민</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>voss_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- dsr_msgs2 는 rosdep 에 없다: 실기·에뮬레이터에서 ~/cobot2_ws 오버레이로 쓴다(doosan.py 지연 import) -->
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
