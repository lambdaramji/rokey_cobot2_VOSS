# docker/web/.env 로 복사해서 값을 채운다. .env 는 .gitignore 에 있어 커밋되지 않는다.
# 계정·테이블은 docker/db/init/01_schema.sql, 02_roles.sh 가 만든다 (voss_web: sort_log SELECT, session_plan 읽기·쓰기).

# MQTT (mqtt.md #20): 계정 web, 공용 PC 호스트 1883
VOSS_MQTT_ENABLED=false
VOSS_MQTT_WEB_PASSWORD=

# PostgreSQL 조회 (sort_log SELECT 전용 — ADR-0006)
VOSS_DB_READ_URL=jdbc:postgresql://127.0.0.1:5432/voss
VOSS_DB_READ_USER=voss_web
VOSS_DB_READ_PASSWORD=

# PostgreSQL session_plan 쓰기 (같은 voss_web 계정을 써도 된다)
VOSS_DB_PLAN_URL=jdbc:postgresql://127.0.0.1:5432/voss
VOSS_DB_PLAN_USER=voss_web
VOSS_DB_PLAN_PASSWORD=
