# VOSS T13 #22 - 웹 HMI 환경 변수
# .env는 로컬 실제 값, .env.example은 Git 공유용 빈 템플릿이다.
# 두 파일의 변수 위치와 주석은 동일하게 유지한다.
# 근거: docs/interfaces/web_api.md, mqtt.md, ADR-0006

# PostgreSQL - sort_log 조회 전용
VOSS_DB_READ_URL=jdbc:postgresql://127.0.0.1:5432/voss
VOSS_DB_READ_USER=voss_web
VOSS_DB_READ_PASSWORD=

# PostgreSQL - session_plan 조회·수정
VOSS_DB_PLAN_URL=jdbc:postgresql://127.0.0.1:5432/voss
VOSS_DB_PLAN_USER=voss_web
VOSS_DB_PLAN_PASSWORD=

# MQTT - Mosquitto (127.0.0.1:1883)
VOSS_MQTT_ENABLED=false
VOSS_MQTT_WEB_PASSWORD=

# 웹 명령 안전 제한
VOSS_NONSTOP_COMMANDS_ENABLED=false
VOSS_OPERATOR_IP=
