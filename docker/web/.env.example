# Web PC 전용: runo-ros (172.24.0.51)
# 이 파일은 Git에 공유하는 템플릿이다. 실제 암호를 넣지 않는다.
# 기존 docker/web/.env가 있다면 덮어쓰지 말고 필요한 항목만 반영한다.
# 근거: docs/interfaces/web_api.md (#68), mqtt.md (#20),
#       deployment_two_pc_trial.md (2대 PC 통합 시험 제안).

# Spring Boot ↔ Web PC 로컬 Mosquitto (127.0.0.1:1883)
# 브로커와 web 계정 인증을 준비한 뒤 실제 .env에서 true로 변경한다.
VOSS_MQTT_ENABLED=false
VOSS_MQTT_WEB_PASSWORD=

# 웹 명령 안전 제한: 비-stop 명령은 통합 시험 중 기본 차단한다.
# VOSS_OPERATOR_IP는 운영자 PC 식별 제안값이며 단독 인증 수단이 아니다.
VOSS_NONSTOP_COMMANDS_ENABLED=false
VOSS_OPERATOR_IP=172.24.3.240

# Spring Boot ↔ Web PC 로컬 PostgreSQL (127.0.0.1:5432)
# voss_web: sort_log SELECT, session_plan 읽기·쓰기 (ADR-0006)
VOSS_DB_READ_URL=jdbc:postgresql://127.0.0.1:5432/voss
VOSS_DB_READ_USER=voss_web
VOSS_DB_READ_PASSWORD=

VOSS_DB_PLAN_URL=jdbc:postgresql://127.0.0.1:5432/voss
VOSS_DB_PLAN_USER=voss_web
VOSS_DB_PLAN_PASSWORD=
