# docker/db/.env 로 복사해서 값을 채운다. .env 는 .gitignore 에 있어 커밋되지 않는다.
# 관리자 계정 (스키마·계정 만들 때만 쓴다)
POSTGRES_USER=voss_admin
POSTGRES_PASSWORD=
# sort_logger(ROS) 계정 — 호스트에서 sort_logger 를 띄우는 터미널에도 같은 값을 export 한다
VOSS_DB_LOGGER_PASSWORD=
# Spring Boot 계정 (sort_log 읽기 전용, session_plan 읽기·쓰기)
VOSS_DB_WEB_PASSWORD=
