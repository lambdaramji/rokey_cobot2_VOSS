# docker/ai/.env 로 복사해서 값을 채운다. .env 는 .gitignore 에 있어 커밋되지 않는다.
OPENAI_API_KEY=

# pending #18: structured output(JSON Schema strict) 을 지원하는 모델 이름. 정해지면 README 에 기록
OPENAI_MODEL=gpt-4o

# pending #6 (10/08 동시 부하 시험 후 확정): tiny | base | small | medium
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
LLM_TIMEOUT_S=3
WHISPER_PROMPT=헬로우 로키. 헬로 로키. 역삼동, 대치동, 청담동. 박스, 분류, 보류, 일시 정지, 시작, 재개, 현재 상태, 작업 이력, 보류 구역.

# T10 — OpenAI TTS
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
TTS_TIMEOUT_S=5
TTS_OPENAI_API_KEY=