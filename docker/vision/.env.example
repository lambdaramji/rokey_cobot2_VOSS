# docker/vision/.env — 이 파일을 복사해 쓴다(.env 는 커밋하지 않는다). 값은 compose.yml 의 기본값과 같다.

# ── 도메인 ──
# ⚠ compose 는 셸에 export 된 값을 이 파일보다 먼저 쓴다 → 보통은 compose 를 실행한 셸의 ROS_DOMAIN_ID 를 따른다(호스트 노드와 같아진다).
# 공용 PC 운용: 셸 30 그대로. 개인 PC 시험: `ROS_DOMAIN_ID=77 ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST docker compose up` 처럼 셸에서 준다.
# 아래 두 줄은 셸에 값이 없을 때만 쓰인다.
ROS_DOMAIN_ID=77
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# ── 호스트 경로 (절대 경로) ──
# 공용 PC: ${HOME}/voss_ws/config (G0·G1 실값 사본) / 개인 PC: 레포 config/
VOSS_CONFIG_HOST=${HOME}/voss_ws/src/rokey_cobot2_VOSS/config
# 호스트 노드와 같은 CycloneDDS 설정(공용 PC 는 lo, wlo1 추가 뒤에는 그 파일)
CYCLONEDDS_XML=${HOME}/.config/cyclonedds/cyclonedds.xml
# 녹화 폴더(읽기 전용으로 /data 에 붙는다)와 노드 로그
VOSS_DATA=${HOME}/voss_data
VOSS_LOG_DIR=${HOME}/voss_data/logs/vision

# ── 노드 인자 ──
# box_tracker 녹화 재생 시험(도메인 30 이면 노드가 거부). 비우면 카메라 실시간(/camera/color/image_raw)
BOX_TRACKER_ARGS=playback:=/data/1006_raw/voss_data/1006/t17/A_MIX_01
# OCR: cpu | gpu:0 — compose.gpu.yml 을 쓰면 이 값과 상관없이 gpu:0
OCR_DEVICE=cpu
