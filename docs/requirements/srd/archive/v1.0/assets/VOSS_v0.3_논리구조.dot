digraph VOSS {
  graph [rankdir=LR, bgcolor="white", nodesep=0.38, ranksep=0.6, pad=0.24, label="VOSS SRD v0.3 | 합의된 기능 연결 · 실기 통과는 별도", labelloc=t, fontsize=20, fontname="Noto Sans CJK KR"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2FB", color="#456B91", fontname="Noto Sans CJK KR", fontsize=12, margin="0.15,0.10"];
  edge [fontname="Noto Sans CJK KR", fontsize=10, color="#516577", arrowsize=0.7];
  camera [label="손목 RGB 카메라\n1080p · 촬영 stamp"];
  vision [label="비전 / 남현지\nbox_tracker · label_reader\n윗면 중심 base(m) · OCR"];
  manager [label="작업 관리자 / 남현지\nready · 업무 ID · FSM\n대상/구역 · 최종 결과", fillcolor="#D9ECE7"];
  servo [label="서보 / 박병후\nTCP 목표 · 추종/픽업\ngoal 안 retry · LIFT/VERIFY", fillcolor="#E7E0F1"];
  gateway [label="장비 게이트웨이 / 김학민\nTCP 변환 · 모션/RG2 · stop\nPLACE/VIEW/PICK · 복귀", fillcolor="#FFF0D8"];
  robot [label="로봇 · RG2\n벨트는 작업자가 수동 운전", fillcolor="#F1F1F1"];
  logger [label="sort_logger / 정의석\n최종 1건 · 스풀\ncommit 성공 로그"];
  db [label="PostgreSQL\nPK = box_id\n공식 이력 원천", shape=cylinder];
  spring [label="Spring Boot / 정의석\nREST /api/stats\nMQTT 클라이언트 · SSE"];
  web [label="React + Nginx HMI\n로컬 운전 · 원격 조회/stop"];
  bridge [label="hmi_bridge / 정의석\nROS ↔ MQTT\ncommand_id · 접수 ack"];
  voice [label="음성 / 정의석\nlistener · intent_parser · TTS\nFastAPI Whisper/OpenAI"];
  config [label="단일 YAML / snapshot\nwriter = manager\nversion/hash · 단위/유효성",fillcolor="#F1F1F1"];
  camera -> vision [label="RGB · CameraInfo"];
  vision -> manager [label="BoxTrack · LabelRead"];
  vision -> servo [label="관측 중심/valid"];
  manager -> servo [label="TrackAndGrasp"];
  servo -> manager [label="최종 result / 인계"];
  servo -> gateway [label="TCP Twist · async gripper"];
  gateway -> servo [label="TCP pose · 피드백"];
  gateway -> vision [label="TCP pose 이력",style=dashed];
  manager -> gateway [label="PLACE/VIEW/PICK · stop"];
  gateway -> manager [label="placed_stamp · 복귀 응답"];
  gateway -> robot [label="단일 장비 접근"];
  manager -> logger [label="SortResult 1건/box"];
  logger -> db [label="멱등 저장 / commit"];
  db -> spring [label="조회"];
  manager -> bridge [label="state/result/zone_map"];
  gateway -> bridge [label="RobotState"];
  bridge -> spring [label="MQTT · ack"];
  spring -> bridge [label="canonical 명령"];
  bridge -> manager [label="Command 접수"];
  spring -> web [label="SSE · REST"];
  web -> spring [label="명령/조회"];
  voice -> manager [label="Intent · box_id"];
  manager -> voice [label="say · 질문"];
  voice -> spring [label="공식 이력 조회"];
  config -> manager [style=dashed];
  config -> vision [style=dashed];
  config -> servo [style=dashed];
  config -> gateway [style=dashed];
}
