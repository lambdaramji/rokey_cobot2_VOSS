flowchart LR
  classDef node fill:#EEF3FA,stroke:#13315C,color:#0B2545
  classDef core fill:#13315C,stroke:#13315C,color:#FFFFFF
  classDef ctn fill:#FFFFFF,stroke:#2F6FB5,stroke-dasharray:6 3,color:#0B2545
  classDef ext fill:#F2F2F2,stroke:#777,color:#333

  subgraph IN["센서"]
    CAM[("realsense2_camera<br/>/camera/color/image_raw")]:::ext
    MIC[("마이크")]:::ext
  end
  subgraph PERC["인지 (판단 결과만 올린다)"]
    BT["box_tracker"]:::ctn
    LR["label_reader"]:::ctn
    VL["voice_listener"]:::node
    IP["intent_parser"]:::node
  end
  SM["sort_manager<br/>작업 상태기계"]:::core
  subgraph ACT["실행 (sort_manager 의 명령만 받는다)"]
    BS["belt_servo 30 Hz"]:::node
    RG["robot_gateway"]:::node
    SO["speech_out"]:::node
  end
  subgraph HW["장치"]
    DSR[("두산 dsr_controller2<br/>/dsr01")]:::ext
    RG2[("OnRobot RG2")]:::ext
    SPK[("스피커")]:::ext
  end
  subgraph IO["사람 · 기록"]
    HB["hmi_bridge"]:::node
    SL["sort_logger"]:::node
    MQ[("Mosquitto → Spring Boot → React")]:::ext
    PG[("PostgreSQL")]:::ext
  end
  AI[("FastAPI :8000<br/>stt · intent · tts")]:::ext

  CAM -- "image_raw 30 fps" --> BT
  BT -- "/voss/vision/label_crop" --> LR
  BT -- "/voss/vision/box ~30 Hz" --> SM
  BT -- "/voss/vision/box" --> BS
  LR -- "/voss/vision/label" --> SM
  SM == "srv read_label (3차)" ==> LR
  SM -- "/voss/sort/zone_map · state" --> LR
  MIC --> VL -- "/voss/voice/transcript" --> IP
  IP -- "/voss/voice/intent" --> SM
  SM -- "/voss/sort/zone_map · state" --> IP
  VL -. "POST /ai/stt" .-> AI
  IP -. "POST /ai/intent" .-> AI
  SO -. "POST /ai/tts" .-> AI
  SM == "action track_and_grasp" ==> BS
  BS -- "/voss/robot/servo_cmd 30 Hz" --> RG
  RG -- "/voss/robot/pose 50 Hz" --> BS
  BS == "srv gripper · stop" ==> RG
  SM == "srv move_to_zone · stop" ==> RG
  RG -- "/voss/robot/pose · state" --> SM
  RG -- "speedl_stream · srv move_line … (단일 큐)" --> DSR
  DSR -- "/dsr01/joint_states" --> RG
  RG <-. "Modbus TCP" .-> RG2
  SM -- "/voss/voice/say" --> SO --> SPK
  SM -- "/voss/sort/state · result<br/>/voss/pallet/state · result" --> HB
  HB == "srv /voss/sort/command" ==> SM
  HB <-. "MQTT voss/*" .-> MQ
  SM -- "/voss/sort/result · /voss/pallet/result" --> SL
  SL -- "/voss/log/status" --> SM
  SL -. "INSERT" .-> PG
