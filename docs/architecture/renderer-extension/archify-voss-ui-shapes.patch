diff --git a/archify/renderers/architecture/render-architecture.mjs b/archify/renderers/architecture/render-architecture.mjs
index 8269df9..d957077 100644
--- a/archify/renderers/architecture/render-architecture.mjs
+++ b/archify/renderers/architecture/render-architecture.mjs
@@ -1080,6 +1080,28 @@ function renderConnectionLabel(conn, index) {
         </g>`;
 }
 
+function vossFlowShape(c, cls, animate = '') {
+  const x = c.x, y = c.y, w = c.width, h = c.height;
+  const common = `class="${cls}"${animate} stroke-width="1.5"`;
+  if (c.shape === 'decision') {
+    return `<path d="M ${x+w/2} ${y} L ${x+w} ${y+h/2} L ${x+w/2} ${y+h} L ${x} ${y+h/2} Z" ${common}/>`;
+  }
+  if (c.shape === 'input') {
+    const k = Math.min(22, w * 0.12);
+    return `<path d="M ${x+k} ${y} L ${x+w} ${y} L ${x+w-k} ${y+h} L ${x} ${y+h} Z" ${common}/>`;
+  }
+  if (c.shape === 'delay') {
+    const q = Math.min(h/2, 38);
+    return `<path d="M ${x} ${y} L ${x+w-q} ${y} Q ${x+w} ${y} ${x+w} ${y+h/2} Q ${x+w} ${y+h} ${x+w-q} ${y+h} L ${x} ${y+h} Z" ${common}/>`;
+  }
+  if (c.shape === 'database') {
+    const k = Math.min(12, h * 0.15);
+    return `<path d="M ${x} ${y+k} C ${x} ${y-k/2} ${x+w} ${y-k/2} ${x+w} ${y+k} L ${x+w} ${y+h-k} C ${x+w} ${y+h+k/2} ${x} ${y+h+k/2} ${x} ${y+h-k} Z" ${common}/><path d="M ${x} ${y+k} C ${x} ${y+2*k} ${x+w} ${y+2*k} ${x+w} ${y+k}" fill="none" class="${cls}" stroke-width="1.5"/>`;
+  }
+  const rx = c.shape === 'terminator' ? h / 2 : c.shape === 'process' ? 3 : 8;
+  return `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${rx}" ${common}/>`;
+}
+
 function renderComponent(c) {
   const fill = componentFill[c.type] || 'c-external';
   const accent = componentText[c.type] || 't-muted';
@@ -1097,9 +1119,9 @@ function renderComponent(c) {
   const passport = { kind: c.type, sublabel: c.sublabel, tag: c.tag, context: componentContext(c), ...brandMetadataFor(c) };
   return `        <g ${focusNodeAttrs(c.id, c.label, passport, arch.meta.locale)}>
           ${focusNodeTitle(c.label, passport)}
-          <rect x="${c.x}" y="${c.y}" width="${c.width}" height="${c.height}" rx="8" class="c-mask"/>
-          <rect x="${c.x}" y="${c.y}" width="${c.width}" height="${c.height}" rx="8" class="${fill}"${animateAttr(arch.meta, 'node', componentSteps.get(c.id))} stroke-width="1.5"/>
-          ${renderSemanticSigil(c.type, { icon: c.icon, x: c.x + 6, y: c.y + 6 })}${brand ? `\n          ${brand}` : ''}
+          ${vossFlowShape(c, 'c-mask')}
+          ${vossFlowShape(c, fill, animateAttr(arch.meta, 'node', componentSteps.get(c.id)))}
+          ${c.shape ? '' : renderSemanticSigil(c.type, { icon: c.icon, x: c.x + 6, y: c.y + 6 })}${brand ? `\n          ${brand}` : ''}
           <text data-node-label=""${hasSub ? ' data-detail-anchor=""' : ''} x="${cx}" y="${labelY}" class="t-primary" font-size="${labelFontSize}" font-weight="600" text-anchor="middle">${esc(c.label)}</text>${sub}${tag}
         </g>`;
 }
