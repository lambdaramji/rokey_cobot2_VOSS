erDiagram
  sort_log {
    varchar32 box_id PK "session_id + -NNN"
    varchar24 session_id "NOT NULL · YYYYMMDDTHHMMSS-xxxx"
    integer track_id "BoxTrack.track_id"
    varchar16 code "S07-01 … (DEFAULT '')"
    varchar16 dong "DEFAULT ''"
    real confidence "0~1"
    varchar8 decided_by "OCR · RECHECK · OPERATOR · NONE"
    varchar8 zone "A · B · C · RECHECK · HOLD · ''"
    varchar8 result "PLACED · HELD · FAILED · PASSED"
    varchar24 reason "LOW_CONF · NO_ANSWER · NON_TARGET · STOPPED …"
    text raw_text "OCR 원문"
    varchar16 second_region "dong_alt"
    varchar16 rule_version "ZoneMap.version"
    smallint attempts "DEFAULT 0"
    smallint retries "GENERATED attempts-1"
    timestamptz started_at "첫 관측 (0 → NULL)"
    timestamptz finished_at "NOT NULL · SortResult.stamp"
    timestamptz inserted_at "DEFAULT now()"
    smallint slot "격자 칸 (Sprint 2, −1 → NULL)"
  }
  pallet_log {
    varchar24 run_id PK "팔레타이징 실행"
    varchar32 box_id PK "sort_log.box_id (FK 없음 — 스풀 지연)"
    varchar24 session_id "NOT NULL"
    varchar16 dong "DEFAULT ''"
    smallint route_index "0 첫 배송지 · −1 EXCLUDED"
    varchar8 zone "집은 구역 A · B · C"
    smallint slot "집은 칸 ≥ 0"
    smallint pallet_slot "0~15 = (열−1)×4+(층−1)×2+(줄−1) · NULL 미적재"
    smallint pallet_col "1~4 (1 = 트럭 머리 −X)"
    smallint pallet_lane "1~2"
    smallint pallet_layer "1~2 (2 = +27 mm)"
    varchar8 result "DONE · FAILED · OVERFLOW · EXCLUDED"
    varchar24 reason "GRIP_FAIL · DROPPED · STOPPED · DEVICE_ERROR"
    smallint attempts "DEFAULT 0"
    timestamptz finished_at "NOT NULL · PalletResult.stamp"
    timestamptz inserted_at "DEFAULT now()"
  }
  session_plan {
    varchar24 session_id PK "세션 전엔 'next'"
    integer planned "1~100 투입 예정 수량"
    timestamptz updated_at "DEFAULT now()"
  }
  sort_log ||--o{ pallet_log : "box_id (논리적, 세션 적재 기록 → 팔레트 이동)"
  session_plan ||--o| sort_log : "session_id (attachPending: next → 세션)"
